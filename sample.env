# Azure OpenAI
GPT_KEY=your-azure-openai-api-key
GPT_ENDPOINT=https://your-resource.openai.azure.com/
GPT_API_VERSION=2024-08-01-preview
GPT_MODEL=gpt-4o

# OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=your-openrouter-api-key

# Ollama (local OpenAI-compatible API)
# Start Ollama, then: ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Optional Gradio sign-in for the week 2 demos
# GRADIO_USER=akalanka
# GRADIO_PASSWORD=your-password

# Optional Azure deployments used by the week 2 multimodal cells.
# Chat still runs if these are unset.
# IMAGE_MODEL=gpt-image-1-mini
# TTS_MODEL=gpt-4o-mini-tts
# WHISPER_MODEL=whisper
